# Optinet Solutions Dashboard — environment template
# Copy this file to .env and fill it in from the demo's OWN Supabase project.
# .env is gitignored, so real keys never get committed. Never reuse another project's keys.

# ─── Supabase project (Project Settings → API) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: used only by `npm run db:seed` to create the demo login.
# Never expose it to the browser; it is not needed on Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Connect → Session pooler connection string) ───────────
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@your-pooler-host:5432/postgres

# ─── App-level encryption ────────────────────────────────────────────
# 32 random bytes, hex (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts the password/API-token columns. Use the same value on Vercel. Changing it
# after seeding makes those values unreadable until you run `npm run db:seed` again.
ENCRYPTION_KEY=

# ─── Demo login ──────────────────────────────────────────────────────
# Password for demo@optinetsolutions.com, set (or reset) by `npm run db:seed`.
DEMO_PASSWORD=

# ─── Optional: Ask AI ────────────────────────────────────────────────
# Leave unset to keep the assistant switched off.
# OPENAI_API_KEY=
